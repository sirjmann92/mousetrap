{
  "name": "mousetrap",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.18.0"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.16.0"
    }
  },
  "scripts": {
    "start": "npm --prefix frontend run start",
    "build": "npm --prefix frontend run build",
    "serve": "npm --prefix frontend run serve",
    "lint": "uv run prek run --all-files",
    "lint:fix": "npm --prefix frontend run lint:fix",
    "audit": "npm --prefix frontend audit --omit=dev --no-fund",
    "check": "npm run lint && npm run audit",
    "tsc": "npm --prefix frontend run tsc",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "backend": "npm --prefix frontend run backend",
    "dev": "npm --prefix frontend run dev",
    "test": "ALLOW_MISSING_COVERAGE=true npm --prefix frontend exec -- concurrently -m 1 --names backend,e2e,coverage \"npm:test:backend\" \"npm:test:e2e\" \"npm:coverage:summary\"",
    "test:backend": "uv run pytest tests/backend",
    "test:backend:integration": "uv run pytest tests/backend -m integration",
    "test:backend:workflow": "uv run pytest tests/backend -m workflow",
    "test:container": "./scripts/test-container.sh",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:e2e:container": "npm --prefix frontend run test:e2e:container"
  }
}
