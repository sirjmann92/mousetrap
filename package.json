{
	"name": "mousetrap",
	"private": true,
	"engines": {
		"node": ">=24.18.0",
		"npm": ">=11.16.0"
	},
	"scripts": {
		"start": "npm --prefix frontend run start",
		"build": "npm --prefix frontend run build",
		"serve": "npm --prefix frontend run serve",
		"lint": "npm --prefix frontend run lint",
		"lint:fix": "npm --prefix frontend run lint:fix",
		"tsc": "npm --prefix frontend run tsc",
		"backend": "npm --prefix frontend run backend",
		"dev": "npm --prefix frontend run dev",
		"test:backend:integration": ".venv/bin/python -m pytest -m integration",
		"test:backend:workflow": ".venv/bin/python -m pytest -m workflow",
		"test:backend:all": ".venv/bin/python -m pytest",
		"test:e2e": "npm --prefix frontend run test:e2e",
		"test:e2e:container": "npm --prefix frontend run test:e2e:container"
	}
}
